+    let kd = x + SHIFT;
+    let ki = kd.to_bits();
+    let kd = kd - SHIFT;
+    let r = x - kd;
+    let row = EXP_TAB[(ki & 127) as usize];
+    let sbits = row[1].wrapping_add(ki.wrapping_shl(45));
+    let r2 = r * r;
+    let tmp =
