-    // uint32_t ix, i0;
-    // union {double f; uint64_t i;} u = {x};
-    // union {uint32_t u; int32_t i;} k;
-    let x1p1023 = f64::from_bits(0x7fe0000000000000);
-    let x1p52 = f64::from_bits(0x4330000000000000);
